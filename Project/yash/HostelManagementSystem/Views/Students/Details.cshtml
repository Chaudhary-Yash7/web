@model HostelManagementSystem.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Student Profile</h2>
        <p class="text-muted mb-0 small">View student details, allocations, and payment records</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil-square me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Student Summary Card -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-3 text-center p-4">
            <div class="bg-primary text-white rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px; font-size: 1.75rem;">
                @(Model.FullName.Substring(0, 1).ToUpper())
            </div>
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <p class="text-muted mb-3">@Model.Course &bull; Semester @Model.Semester</p>

            <ul class="list-group list-group-flush text-start small">
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span class="text-muted">Student ID:</span>
                    <span class="fw-bold">#@Model.StudentId</span>
                </li>
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span class="text-muted">Email:</span>
                    <span class="fw-semibold">@Model.Email</span>
                </li>
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span class="text-muted">Phone:</span>
                    <span class="fw-semibold">@Model.Phone</span>
                </li>
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span class="text-muted">Address:</span>
                    <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Address) ? "None specified" : Model.Address)</span>
                </li>
            </ul>
        </div>
    </div>

    <!-- Allocation & Payment History -->
    <div class="col-lg-8">
        <!-- Room Allocations -->
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-key text-primary me-2"></i>Room Allocation History</h6>
            </div>
            <div class="card-body p-0">
                @if (Model.Allocations != null && Model.Allocations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Room</th>
                                    <th>Allocated Date</th>
                                    <th>Check-Out Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alloc in Model.Allocations)
                                {
                                    <tr>
                                        <td class="fw-bold">Room @(alloc.Room?.RoomNumber ?? "N/A") (@(alloc.Room?.RoomType))</td>
                                        <td>@alloc.AllocationDate.ToString("dd MMM yyyy")</td>
                                        <td>@(alloc.CheckOutDate.HasValue ? alloc.CheckOutDate.Value.ToString("dd MMM yyyy") : "Ongoing")</td>
                                        <td>
                                            @if (alloc.Status == "Active")
                                            {
                                                <span class="badge bg-success badge-custom">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary badge-custom">@alloc.Status</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">No rooms allocated to this student yet.</div>
                }
            </div>
        </div>

        <!-- Payments -->
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-credit-card text-primary me-2"></i>Payment History</h6>
            </div>
            <div class="card-body p-0">
                @if (Model.Payments != null && Model.Payments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Month</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Payments)
                                {
                                    <tr>
                                        <td>@p.PaymentMonth</td>
                                        <td class="fw-bold">₹@p.Amount.ToString("N0")</td>
                                        <td>@p.PaymentDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@p.PaymentMethod</span></td>
                                        <td>
                                            @if (p.PaymentStatus == "Paid")
                                            {
                                                <span class="badge bg-success badge-custom">Paid</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger badge-custom">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">No payment records found.</div>
                }
            </div>
        </div>
    </div>
</div>

