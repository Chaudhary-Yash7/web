@model HostelManagementSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Student Deletion</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">Are you sure you want to delete this student record?</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Full Name</dt>
                    <dd class="col-sm-8 fw-bold">@Model.FullName</dd>

                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4 text-muted">Course</dt>
                    <dd class="col-sm-8">@Model.Course (Sem @Model.Semester)</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="StudentId" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Yes, Delete Student
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

