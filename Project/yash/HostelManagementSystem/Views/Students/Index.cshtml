@model IEnumerable<HostelManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Students List";
    var isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="h4 fw-bold mb-1">@(isAdmin ? "Student Management" : "My Student Profile")</h2>
        <p class="text-muted mb-0 small">@(isAdmin ? "Manage registered hostel students and view academic details" : "Your official hostel enrollment information")</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Student
        </a>
    }
</div>

@if (isAdmin)
{
    <!-- Search Bar (Admin Only) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-9 col-sm-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-start-0" placeholder="Search student by name, email, phone, or course..." />
                    </div>
                </div>
                <div class="col-md-3 col-sm-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>
}

<!-- Students Table -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Course</th>
                            <th>Semester</th>
                            <th>Address</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                            @(item.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <span>@item.FullName</span>
                                    </div>
                                </td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td><span class="badge bg-light text-dark border">@item.Course</span></td>
                                <td>Semester @item.Semester</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Address) ? "N/A" : item.Address)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-outline-primary" title="Edit Information">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-outline-danger" title="Delete Student">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                <p class="mb-2">No student records found.</p>
                @if (isAdmin)
                {
                    <a asp-action="Create" class="btn btn-sm btn-primary">Add New Student</a>
                }
            </div>
        }
    </div>
</div>
