<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hostel Room Allocation & Management System</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Header Navigation Bar -->
    <header class="main-header border-bottom bg-white shadow-sm sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container-fluid px-3 px-md-4">
                <!-- Brand Logo / Title -->
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="bi bi-building"></i>
                    </div>
                    <div>
                        <span class="fw-bold fs-5 text-dark">HostelCare</span>
                        <div class="small text-muted d-none d-sm-block" style="font-size: 0.72rem; margin-top: -3px;">Management System</div>
                    </div>
                </a>

                <!-- Mobile Menu Toggle Button -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#headerNav" aria-controls="headerNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links in Header (All modules always accessible) -->
                <div class="collapse navbar-collapse" id="headerNav">
                    @{
                        var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
                        var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
                    }
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 @(currentCtrl == "Home" ? "active fw-bold text-primary" : "text-secondary")" 
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 @(currentCtrl == "Students" ? "active fw-bold text-primary" : "text-secondary")" 
                               asp-controller="Students" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Students
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 @(currentCtrl == "Rooms" ? "active fw-bold text-primary" : "text-secondary")" 
                               asp-controller="Rooms" asp-action="Index">
                                <i class="bi bi-door-open me-1"></i> Rooms
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 @(currentCtrl == "Allocations" ? "active fw-bold text-primary" : "text-secondary")" 
                               asp-controller="Allocations" asp-action="Index">
                                <i class="bi bi-key me-1"></i> Allocations
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 @(currentCtrl == "Payments" ? "active fw-bold text-primary" : "text-secondary")" 
                               asp-controller="Payments" asp-action="Index">
                                <i class="bi bi-credit-card me-1"></i> Payments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 @(currentCtrl == "Maintenance" ? "active fw-bold text-primary" : "text-secondary")" 
                               asp-controller="Maintenance" asp-action="Index">
                                <i class="bi bi-tools me-1"></i> Maintenance
                            </a>
                        </li>
                    </ul>

                    <!-- User / Auth Controls in Header -->
                    <div class="d-flex align-items-center gap-2 pt-2 pt-lg-0 border-top border-lg-0">
                        @if (isAuthenticated)
                        {
                            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
                            var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;

                            <div class="d-flex align-items-center gap-2 me-2">
                                <div class="user-pill d-flex align-items-center gap-2 px-3 py-1 bg-light rounded-pill border">
                                    <i class="bi bi-person-circle text-primary"></i>
                                    <span class="fw-semibold small text-dark">@fullName</span>
                                    <span class="badge @(role == "Admin" ? "bg-primary" : "bg-success") rounded-pill" style="font-size: 0.7rem;">@role</span>
                                </div>
                            </div>

                            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm px-3">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm px-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3">
                                <i class="bi bi-person-plus-fill me-1"></i> Sign In
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Body -->
    <main class="container-fluid px-3 px-md-4 py-4" role="main">
        <!-- Success & Error Alert Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Bootstrap & jQuery Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
