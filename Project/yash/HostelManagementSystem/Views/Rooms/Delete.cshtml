@model HostelManagementSystem.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Room Deletion</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">Are you sure you want to delete this room from the database?</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Room Number</dt>
                    <dd class="col-sm-8 fw-bold">Room @Model.RoomNumber</dd>

                    <dt class="col-sm-4 text-muted">Type</dt>
                    <dd class="col-sm-8">@Model.RoomType</dd>

                    <dt class="col-sm-4 text-muted">Capacity</dt>
                    <dd class="col-sm-8">@Model.Capacity Beds (@Model.OccupiedBeds occupied)</dd>

                    <dt class="col-sm-4 text-muted">Monthly Fee</dt>
                    <dd class="col-sm-8">₹@Model.MonthlyFee.ToString("N0")</dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="RoomId" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Yes, Delete Room
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

