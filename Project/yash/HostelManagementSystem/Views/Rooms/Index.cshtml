@model IEnumerable<HostelManagementSystem.Models.Room>

@{
    ViewData["Title"] = "Rooms Management";
    var isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="h4 fw-bold mb-1">Hostel Rooms</h2>
        <p class="text-muted mb-0 small">@(isAdmin ? "Manage hostel rooms, bed capacity, pricing, and live availability" : "Browse available hostel rooms, bed capacity, and monthly rates")</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Add New Room
        </a>
    }
</div>

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4 col-sm-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-start-0" placeholder="Search by Room Number..." />
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Room Statuses --</option>
                    <option value="Available" selected="@(ViewData["CurrentStatus"]?.ToString() == "Available")">Available</option>
                    <option value="Occupied" selected="@(ViewData["CurrentStatus"]?.ToString() == "Occupied")">Occupied</option>
                    <option value="Under Maintenance" selected="@(ViewData["CurrentStatus"]?.ToString() == "Under Maintenance")">Under Maintenance</option>
                </select>
            </div>
            <div class="col-md-3 col-sm-6">
                <select name="typeFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Room Types --</option>
                    <option value="Single" selected="@(ViewData["CurrentType"]?.ToString() == "Single")">Single</option>
                    <option value="Double" selected="@(ViewData["CurrentType"]?.ToString() == "Double")">Double</option>
                    <option value="Triple" selected="@(ViewData["CurrentType"]?.ToString() == "Triple")">Triple</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Rooms Table -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Room No.</th>
                            <th>Type</th>
                            <th>Total Capacity</th>
                            <th>Occupied Beds</th>
                            <th>Available Beds</th>
                            <th>Monthly Fee</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var availableBeds = Math.Max(0, item.Capacity - item.OccupiedBeds);
                            <tr>
                                <td class="fw-bold fs-6 text-primary">
                                    <i class="bi bi-door-closed me-1"></i> Room @item.RoomNumber
                                </td>
                                <td>@item.RoomType</td>
                                <td>@item.Capacity Beds</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.OccupiedBeds Beds
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(availableBeds > 0 ? "bg-success" : "bg-secondary")">
                                        @availableBeds Beds
                                    </span>
                                </td>
                                <td class="fw-semibold">₹@item.MonthlyFee.ToString("N0")</td>
                                <td>
                                    @if (item.Status == "Available")
                                    {
                                        <span class="badge bg-success badge-custom">Available</span>
                                    }
                                    else if (item.Status == "Occupied")
                                    {
                                        <span class="badge bg-warning text-dark badge-custom">Occupied</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger badge-custom">@item.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.RoomId" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.RoomId" class="btn btn-outline-primary" title="Edit Room">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.RoomId" class="btn btn-outline-danger" title="Delete Room">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-door-closed fs-1 d-block mb-2 text-secondary"></i>
                <p class="mb-2">No rooms found matching your search and filter criteria.</p>
                @if (isAdmin)
                {
                    <a asp-action="Create" class="btn btn-sm btn-primary">Add New Room</a>
                }
            </div>
        }
    </div>
</div>
