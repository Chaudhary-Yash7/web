@model IEnumerable<HostelManagementSystem.Models.Allocation>

@{
    ViewData["Title"] = "Room Allocations";
    var isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="h4 fw-bold mb-1">Room Allocations</h2>
        <p class="text-muted mb-0 small">@(isAdmin ? "Assign students to available hostel rooms and manage check-outs" : "View your room allocation and stay status")</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-key-fill me-1"></i> Allocate New Room
        </a>
    }
</div>

<!-- Search & Status Filter -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5 col-sm-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-start-0" placeholder="Search by Student or Room Number..." />
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Allocations (Active & Completed) --</option>
                    <option value="Active" selected="@(ViewData["CurrentStatus"]?.ToString() == "Active")">Active Allocations Only</option>
                    <option value="CheckedOut" selected="@(ViewData["CurrentStatus"]?.ToString() == "CheckedOut")">Completed (Checked Out)</option>
                </select>
            </div>
            <div class="col-md-3 col-sm-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Allocations Table -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Course</th>
                            <th>Allocated Room</th>
                            <th>Allocation Date</th>
                            <th>Check-Out Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@(item.Student?.FullName ?? "Unknown")</div>
                                    <div class="text-muted small">@(item.Student?.Email ?? "")</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.Student?.Course ?? "N/A")
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">
                                        <i class="bi bi-door-closed me-1"></i> Room @(item.Room?.RoomNumber ?? "N/A")
                                    </span>
                                    <div class="text-muted small">@(item.Room?.RoomType ?? "")</div>
                                </td>
                                <td>@item.AllocationDate.ToString("dd MMM yyyy")</td>
                                <td>@(item.CheckOutDate.HasValue ? item.CheckOutDate.Value.ToString("dd MMM yyyy") : "Ongoing")</td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success badge-custom">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary badge-custom">Checked Out</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.AllocationId" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        @if (isAdmin)
                                        {
                                            @if (item.Status == "Active")
                                            {
                                                <a asp-action="CheckOut" asp-route-id="@item.AllocationId" class="btn btn-warning text-dark" title="Check Out Student">
                                                    <i class="bi bi-box-arrow-right"></i> Check Out
                                                </a>
                                            }
                                            <a asp-action="Edit" asp-route-id="@item.AllocationId" class="btn btn-outline-primary" title="Edit Allocation">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.AllocationId" class="btn btn-outline-danger" title="Delete Allocation">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-key fs-1 d-block mb-2 text-secondary"></i>
                <p class="mb-2">No room allocations found.</p>
                @if (isAdmin)
                {
                    <a asp-action="Create" class="btn btn-sm btn-primary">Allocate Room</a>
                }
            </div>
        }
    </div>
</div>
