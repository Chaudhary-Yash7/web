@model HostelManagementSystem.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Delete Maintenance Ticket";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Ticket Deletion</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">Are you sure you want to delete this maintenance ticket?</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Room</dt>
                    <dd class="col-sm-8 fw-bold">Room @(Model.Room?.RoomNumber)</dd>

                    <dt class="col-sm-4 text-muted">Issue</dt>
                    <dd class="col-sm-8">@Model.IssueTitle</dd>

                    <dt class="col-sm-4 text-muted">Date</dt>
                    <dd class="col-sm-8">@Model.RequestDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="MaintenanceRequestId" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Yes, Delete Ticket
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

