@model IEnumerable<HostelManagementSystem.Models.MaintenanceRequest>

@{
    ViewData["Title"] = "Maintenance Requests";
    var isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="h4 fw-bold mb-1">@(isAdmin ? "Hostel Maintenance & Complaints" : "My Maintenance Requests")</h2>
        <p class="text-muted mb-0 small">@(isAdmin ? "Manage room repair tickets, plumbing, electricity, and room upkeep" : "Submit and track room repair issues and complaints")</p>
    </div>
    <a asp-action="Create" class="btn btn-warning text-dark btn-sm px-3 fw-semibold">
        <i class="bi bi-tools me-1"></i> New Maintenance Request
    </a>
</div>

<!-- Search & Status Filter -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            @if (isAdmin)
            {
                <div class="col-md-5 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-start-0" placeholder="Search by Issue Title, Room, or Student..." />
                    </div>
                </div>
            }
            <div class="@(isAdmin ? "col-md-4" : "col-md-9") col-sm-6">
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Maintenance Statuses --</option>
                    <option value="Pending" selected="@(ViewData["CurrentStatus"]?.ToString() == "Pending")">Pending Only</option>
                    <option value="In Progress" selected="@(ViewData["CurrentStatus"]?.ToString() == "In Progress")">In Progress Only</option>
                    <option value="Resolved" selected="@(ViewData["CurrentStatus"]?.ToString() == "Resolved")">Resolved Only</option>
                </select>
            </div>
            <div class="@(isAdmin ? "col-md-3" : "col-md-3") col-sm-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Maintenance Table -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Room</th>
                            <th>Issue Title</th>
                            <th>Reported By</th>
                            <th>Date Reported</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-primary">
                                        <i class="bi bi-door-closed me-1"></i> Room @(item.Room?.RoomNumber ?? "N/A")
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.IssueTitle</div>
                                    <div class="text-muted small text-truncate" style="max-width: 250px;">@item.Description</div>
                                </td>
                                <td>
                                    @if (item.Student != null)
                                    {
                                        <span>@item.Student.FullName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Hostel Warden / Staff</span>
                                    }
                                </td>
                                <td>@item.RequestDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-danger badge-custom">Pending</span>
                                    }
                                    else if (item.Status == "In Progress")
                                    {
                                        <span class="badge bg-warning text-dark badge-custom">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success badge-custom">Resolved</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.MaintenanceRequestId" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.MaintenanceRequestId" class="btn btn-outline-primary" title="Update Status">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MaintenanceRequestId" class="btn btn-outline-danger" title="Delete Ticket">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-tools fs-1 d-block mb-2 text-secondary"></i>
                <p class="mb-2">No maintenance requests found.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Create Maintenance Ticket</a>
            </div>
        }
    </div>
</div>
