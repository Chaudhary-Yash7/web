@model HostelManagementSystem.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Update Maintenance Ticket";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="h4 fw-bold mb-1">Update Maintenance Ticket</h2>
                <p class="text-muted mb-0 small">Update issue status or technician notes</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="MaintenanceRequestId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RoomId" class="form-label fw-semibold"></label>
                            <select asp-for="RoomId" class="form-select" asp-items="ViewBag.RoomId"></select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StudentId" class="form-label fw-semibold"></label>
                            <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId">
                                <option value="">-- Hostel Staff / None --</option>
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="IssueTitle" class="form-label fw-semibold"></label>
                            <input asp-for="IssueTitle" class="form-control" />
                            <span asp-validation-for="IssueTitle" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RequestDate" class="form-label fw-semibold"></label>
                            <input asp-for="RequestDate" class="form-control" type="date" />
                            <span asp-validation-for="RequestDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Resolved">Resolved</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

