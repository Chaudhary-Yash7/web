@model HostelManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fs-6 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Payment Deletion</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">Are you sure you want to delete this payment record?</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Student</dt>
                    <dd class="col-sm-8 fw-bold">@(Model.Student?.FullName ?? "Unknown")</dd>

                    <dt class="col-sm-4 text-muted">Amount</dt>
                    <dd class="col-sm-8 text-success fw-bold">₹@Model.Amount.ToString("N0")</dd>

                    <dt class="col-sm-4 text-muted">Month</dt>
                    <dd class="col-sm-8">@Model.PaymentMonth</dd>

                    <dt class="col-sm-4 text-muted">Date</dt>
                    <dd class="col-sm-8">@Model.PaymentDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">@Model.PaymentStatus</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="PaymentId" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Yes, Delete Payment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

