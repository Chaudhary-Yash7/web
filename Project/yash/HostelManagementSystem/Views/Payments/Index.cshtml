@model IEnumerable<HostelManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "Fee & Payments";
    var isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
    <div>
        <h2 class="h4 fw-bold mb-1">@(isAdmin ? "Hostel Fee Payments" : "My Fee Payments & Receipts")</h2>
        <p class="text-muted mb-0 small">@(isAdmin ? "Track monthly fee payments, receipts, and outstanding dues" : "View your payment history and official receipts")</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-success btn-sm px-3">
            <i class="bi bi-cash-stack me-1"></i> Record New Payment
        </a>
    }
</div>

<!-- Demonstration Notice -->
<div class="alert alert-light border shadow-sm py-2 px-3 small rounded-3 mb-4 d-flex align-items-center">
    <i class="bi bi-shield-check text-success fs-5 me-2"></i>
    <div>
        <strong>College Demonstration Project:</strong> Recorded payments are simulated records for administrative tracking. No real payment gateways or banking card credentials are used or stored.
    </div>
</div>

<!-- Search & Status & Month Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            @if (isAdmin)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-start-0" placeholder="Search by Student Name..." />
                    </div>
                </div>
            }
            <div class="@(isAdmin ? "col-md-3" : "col-md-5") col-sm-6">
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Payment Statuses --</option>
                    <option value="Paid" selected="@(ViewData["CurrentStatus"]?.ToString() == "Paid")">Paid Only</option>
                    <option value="Pending" selected="@(ViewData["CurrentStatus"]?.ToString() == "Pending")">Pending Only</option>
                </select>
            </div>
            <div class="@(isAdmin ? "col-md-3" : "col-md-5") col-sm-6">
                <select name="monthFilter" class="form-select form-select-sm" asp-items="ViewBag.AvailableMonths" onchange="this.form.submit()">
                    <option value="">-- All Months --</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Payments Table -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Payment Month</th>
                            <th>Amount</th>
                            <th>Payment Date</th>
                            <th>Payment Method</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@(item.Student?.FullName ?? "Unknown")</div>
                                    <div class="text-muted small">@(item.Student?.Email ?? "")</div>
                                </td>
                                <td class="fw-semibold">@item.PaymentMonth</td>
                                <td class="fw-bold text-success fs-6">₹@item.Amount.ToString("N0")</td>
                                <td>@item.PaymentDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-wallet2 me-1"></i> @item.PaymentMethod
                                    </span>
                                </td>
                                <td>
                                    @if (item.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success badge-custom">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger badge-custom">Pending</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-outline-info" title="View Receipt">
                                            <i class="bi bi-receipt"></i> View Receipt
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.PaymentId" class="btn btn-outline-primary" title="Edit Payment">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.PaymentId" class="btn btn-outline-danger" title="Delete Payment">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-credit-card fs-1 d-block mb-2 text-secondary"></i>
                <p class="mb-2">No payment records found.</p>
                @if (isAdmin)
                {
                    <a asp-action="Create" class="btn btn-sm btn-success">Record Payment</a>
                }
            </div>
        }
    </div>
</div>
