@model HostelManagementSystem.Models.Payment

@{
    ViewData["Title"] = "Payment Receipt";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="h4 fw-bold mb-1">Payment Receipt</h2>
                <p class="text-muted mb-0 small">Official hostel fee payment acknowledgment</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-receipt-cutoff text-success fs-5"></i>
                    <h6 class="mb-0 fw-bold">Receipt #@Model.PaymentId.ToString("D5")</h6>
                </div>
                @if (Model.PaymentStatus == "Paid")
                {
                    <span class="badge bg-success badge-custom">PAID</span>
                }
                else
                {
                    <span class="badge bg-danger badge-custom">PENDING</span>
                }
            </div>

            <div class="card-body p-4">
                <div class="text-center py-3 border-bottom mb-3">
                    <span class="text-muted small text-uppercase">Amount Paid</span>
                    <h2 class="fw-bold text-success mb-0">₹@Model.Amount.ToString("N0")</h2>
                    <span class="text-muted small">For Month: <strong>@Model.PaymentMonth</strong></span>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">Student Name</dt>
                    <dd class="col-sm-7 fw-bold">@(Model.Student?.FullName ?? "Unknown")</dd>

                    <dt class="col-sm-5 text-muted">Student Email</dt>
                    <dd class="col-sm-7">@(Model.Student?.Email ?? "N/A")</dd>

                    <dt class="col-sm-5 text-muted">Student Phone</dt>
                    <dd class="col-sm-7">@(Model.Student?.Phone ?? "N/A")</dd>

                    <dt class="col-sm-5 text-muted">Payment Date</dt>
                    <dd class="col-sm-7">@Model.PaymentDate.ToString("dd MMMM yyyy")</dd>

                    <dt class="col-sm-5 text-muted">Payment Mode</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-light text-dark border">@Model.PaymentMethod</span>
                    </dd>
                </dl>
            </div>

            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Receipt
                </button>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.PaymentId" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash me-1"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

